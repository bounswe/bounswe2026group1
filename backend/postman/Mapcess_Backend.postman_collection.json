            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"test@example.com\",\n  \"password\": \"StrongPass1!\"\n}"
            },
            "url": {
              "raw": "{{authBaseUrl}}/register",
              "host": ["{{authBaseUrl}}"],
              "path": ["register"]
            }
