# All variables are passed at build/run time via --dart-define-from-file.
# Do NOT commit real values. Copy a file from dart_defines/ or create your own.
#
# Usage:
#   flutter run  --dart-define-from-file=dart_defines/production.json
#   flutter run  --dart-define-from-file=dart_defines/local-emulator.json
#   flutter build apk --dart-define-from-file=dart_defines/production.json
#
# For a physical device pointing at your local backend, edit local-device.json
# and replace YOUR_MACHINE_IP with the output of:
#   macOS/Linux : ipconfig getifaddr en0
#   Windows     : ipconfig  (look for IPv4 under your Wi-Fi adapter)
# Make sure the device and your machine are on the same Wi-Fi network.

API_BASE_URL=https://api.mapcess.live   # production default (used when no --dart-define is passed)
API_KEY=bounswe2026-local-api-key
